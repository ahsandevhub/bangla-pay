NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key. Grants elevated access for privileged
# server-side operations (repositories, admin routes). Never expose to the client.
SUPABASE_SECRET_KEY=

# HMAC pepper for PIN credential derivation and NID fingerprinting.
# See docs/ARCHITECTURE.md Identity/PIN Security and KYC sections.
APP_SECURITY_PEPPER=

# Set to "true" to route OTP delivery through the virtual demo SMS inbox
# (GET /api/demo/sms) instead of a real SMS provider. Always "true" for the hackathon.
VIRTUAL_SMS_MODE=

# Bearer token required by GET /api/admin/reconcile.
RECONCILE_ADMIN_TOKEN=
